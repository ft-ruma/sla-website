# Copy to .env.local and fill in. Every value is optional for local development.

# Public address of this website (used for share links and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.athletics.lk

# Where the registration portal runs. Register, coach and club buttons link here.
NEXT_PUBLIC_PORTAL_URL=https://sla.ascendit.dev

# Read-only connection to the registry database, using the web_reader role from
# db/public_views.sql. That role can only read the privacy-safe views.
# Leave empty to show the club directory and athlete lookup as "not connected".
WEB_DATABASE_URL=postgresql://web_reader:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Member sign-in by email (needs db/member_auth.sql and WEB_DATABASE_URL).
# Random secret of 32+ characters for hashing codes and session tokens.
# Changing it signs everyone out. Leave empty to turn member sign-in off.
MEMBER_AUTH_SECRET=
# Mailjet sends the 6-digit codes (Account settings > REST API keys). The
# sender must be on a domain verified in Mailjet with SPF and DKIM. Without
# these, development prints the code in the server console and production
# cannot send codes.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=no-reply@athletics.lk
MAIL_FROM_NAME=Sri Lanka Athletics
# Development only: set to 1 to try member sign-in with fictional records and
# no database. Codes are shown on screen. Ignored in production.
MEMBER_AUTH_MOCK=

# Website admin (/admin). CMS_SECRET signs editor sessions (32+ characters;
# MEMBER_AUTH_SECRET is used if it is empty). The bootstrap script uses an
# owner connection and the first owner's email:
#   CMS_OWNER_EMAIL=you@athletics.lk npm run cms:bootstrap
CMS_SECRET=
CMS_DATABASE_URL=
CMS_OWNER_EMAIL=
CMS_OWNER_NAME=
